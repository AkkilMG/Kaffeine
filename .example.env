# ──────────────────────────────────────────────────────────
# Kaffeine — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/kaffeine

# Encryption Keys
ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars

# JWT Secret (for local session tokens and CF Worker auth)
JWT_SECRET=your-secure-jwt-secret-min-32-chars

# Cloudflare Worker Configuration
CF_API_TOKEN=your-cloudflare-api-token
CF_WORKER_SECRET=your-cloudflare-worker-secret
CF_ACCOUNT_ID=your-cloudflare-account-id

# Node Environment
NODE_ENV=development

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Arkynox Auth (Centralized Authentication)
# Auth server handles sign-in, sign-up, and OAuth for all Arkynox apps.
# Dev port map: Auth 3000 · PikDB 3001 · ArkyDesk 3002 · Kaffeine 3003
# In production: https://auth.arkynox.com
AUTH_SERVER_URL=http://localhost:3000
AUTH_CLIENT_ID=kaffeine
# Must match KAFFEINE_CLIENT_SECRET on the auth server (token-endpoint client auth)
AUTH_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_CLIENT_ID=kaffeine
